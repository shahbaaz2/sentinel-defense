# Development-only placeholders. Never put real secrets in this file or in .env if .env is committed.
SENTINEL_ENV=development
SENTINEL_PROFILE=lite

SENTINEL_DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@127.0.0.1:5432/sentinel

SENTINEL_LLM_PROVIDER=mock
SENTINEL_LLM_BASE_URL=http://127.0.0.1:8000/v1
SENTINEL_LLM_MODEL=mlx-community/Qwen3-4B-Instruct-2507-4bit
SENTINEL_EXTERNAL_AI_ENABLED=false

SENTINEL_RESPONSE_MODE=assisted
SENTINEL_KNOWLEDGE_BUNDLE=KB-local-dev
SENTINEL_POLICY_BUNDLE=PB-local-dev
SENTINEL_SYNTHETIC_ONLY=true

SENTINEL_API_HOST=127.0.0.1
SENTINEL_API_PORT=8080

MISSIONNET_DATABASE_URL=postgresql+asyncpg://missionnet:missionnet@127.0.0.1:5432/missionnet
MISSIONNET_API_HOST=127.0.0.1
MISSIONNET_API_PORT=8090

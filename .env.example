# Development-only placeholders. Never put real secrets in this file or in .env if .env is committed.
SENTINEL_ENV=development
SENTINEL_PROFILE=lite

SENTINEL_DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@127.0.0.1:5432/sentinel

# Phase 5 local AI Analyst. Safe defaults below (disabled, mock provider) work on a fresh
# checkout with no model download. To run the real local model: SENTINEL_AI_ENABLED=true,
# SENTINEL_LLM_PROVIDER=mlx - see RUNBOOK.md "Local AI Analyst". Never set SENTINEL_LLM_PROVIDER
# to a cloud API; only "mock" and "mlx" are implemented, and both run entirely on this machine.
SENTINEL_AI_ENABLED=false
SENTINEL_LLM_PROVIDER=mock
SENTINEL_LLM_BASE_URL=http://127.0.0.1:8000/v1
SENTINEL_LLM_MODEL=mlx-community/Qwen3-4B-Instruct-2507-4bit
SENTINEL_LLM_MAX_TOKENS=1500
SENTINEL_LLM_TIMEOUT_SECONDS=90
SENTINEL_EXTERNAL_AI_ENABLED=false

SENTINEL_RESPONSE_MODE=assisted
SENTINEL_KNOWLEDGE_BUNDLE=KB-local-dev
# Policy bundle version lives in code (services/policy_engine/engine.py::POLICY_BUNDLE_VERSION),
# not here - see DECISIONS.md.
SENTINEL_SYNTHETIC_ONLY=true

SENTINEL_API_HOST=127.0.0.1
SENTINEL_API_PORT=8080

# Phase 7: response execution. The executor is the only Sentinel-side code that calls MissionNet's
# lab-control API (apps/missionnet/lab.py) - these two values must match MISSIONNET_LAB_SECRET
# below. SENTINEL_RESPONSE_EXECUTION_ENABLED=false is an emergency kill switch independent of
# response planning (Phase 6), which always stays on.
SENTINEL_MISSIONNET_BASE_URL=http://127.0.0.1:8090
SENTINEL_MISSIONNET_LAB_SECRET=dev-only-lab-secret-change-me
SENTINEL_RESPONSE_EXECUTION_ENABLED=true

# Phase 8: real sensor adapters. All disabled/absent by default - a fresh checkout behaves exactly
# like Phase 0-7 until an operator opts in. See docs/integrations.md.
# Suricata/Zeek: real, working, batch-mode-only (services/sensor_lab/pipeline.py runs them in
# ephemeral Docker containers against a safe synthetic pcap - see docs/sensor-pipeline.md).
SENTINEL_SURICATA_ENABLED=false
SENTINEL_SURICATA_EVE_PATH=var/sensor-lab/suricata-out/eve.json
SENTINEL_ZEEK_ENABLED=false
SENTINEL_ZEEK_LOG_DIR=var/sensor-lab/zeek-out
# Wazuh: adapter/mapper are real and contract-tested, but no live Wazuh manager runs in this lab
# (too heavy for the Lite profile alongside everything else) - stays NOT_CONFIGURED until a real
# SENTINEL_WAZUH_BASE_URL is set. Never logged, never sent anywhere but the Authorization header.
SENTINEL_WAZUH_ENABLED=false
SENTINEL_WAZUH_BASE_URL=
SENTINEL_WAZUH_API_TOKEN=
SENTINEL_WAZUH_VERIFY_TLS=true
# Splunk: READ-ONLY, bounded search only - see docs/splunk-integration.md. Sentinel is not
# replacing Splunk. Never logged, never sent to frontend JavaScript.
SENTINEL_SPLUNK_ENABLED=false
SENTINEL_SPLUNK_BASE_URL=
SENTINEL_SPLUNK_TOKEN=
SENTINEL_SPLUNK_VERIFY_TLS=true
SENTINEL_SPLUNK_INDEX=
SENTINEL_SPLUNK_QUERY=
# Falco: contract/fixtures only in this phase - see integrations/falco/__init__.py.
SENTINEL_FALCO_ENABLED=false

MISSIONNET_DATABASE_URL=postgresql+asyncpg://missionnet:missionnet@127.0.0.1:5432/missionnet
MISSIONNET_API_HOST=127.0.0.1
MISSIONNET_API_PORT=8090
MISSIONNET_LAB_SECRET=dev-only-lab-secret-change-me

DEMOCONTROL_DATABASE_URL=postgresql+asyncpg://democontrol:democontrol@127.0.0.1:5432/democontrol
DEMOCONTROL_API_HOST=127.0.0.1
DEMOCONTROL_API_PORT=8100
DEMOCONTROL_MISSIONNET_BASE_URL=http://127.0.0.1:8090
DEMOCONTROL_SENTINEL_BASE_URL=http://127.0.0.1:8080
DEMOCONTROL_MISSIONNET_LAB_SECRET=dev-only-lab-secret-change-me
